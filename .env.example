# MAGI Environment Configuration
# Copy to .env and fill in real values. Used by:
#   - docker compose (docker/docker-compose-web.yml) for the full stack
#   - scripts/db.sh (migrate against local MySQL)
# .env is gitignored; never commit real keys.

# --- Model (required: magi-server cannot run decisions without an API key) ---
MAGI_MODEL_API_KEY=sk-your-api-key-here
MAGI_MODEL_BASE_URL=https://api.deepseek.com
MAGI_MODEL_NAME=deepseek-v4-flash

# --- Tavily web search (optional; empty disables the web_search tool) ---
MAGI_TAVILY_API_KEY=

# --- Embedding (RAG vector; empty disables RAG) ---
MAGI_EMBEDDING_API_KEY=
MAGI_EMBEDDING_BASE_URL=
MAGI_EMBEDDING_MODEL_NAME=BAAI/bge-m3

# --- RAG backends (empty -> fake index in local dev) ---
MAGI_MILVUS_ADDRESS=
MAGI_ES_ADDRESSES=

# --- Database (compose uses the internal `mysql` host; db.sh uses DB_HOST/DB_PORT) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=magi
DB_PASS=magi123
DB_NAME=magi
MYSQL_ROOT_PASSWORD=root

# --- Build / runtime knobs (optional) ---
# GOPROXY passed to the backend Docker build. China-friendly default; override
# to https://mirrors.aliyun.com/goproxy,direct or https://proxy.golang.org,direct.
GOPROXY=https://goproxy.cn,direct
# Host port for the web (nginx) service.
WEB_PORT=80
