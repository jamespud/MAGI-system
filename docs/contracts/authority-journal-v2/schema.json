{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "magi://contracts/authority-journal-v2/trace",
  "description": "Additive offline declaration for JOURNAL_ADMIT v2. No provider, authority, transaction or exposure implementation is implied.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "magi-authority-journal-v2/1"
    },
    "operation": {
      "enum": [
        "JOURNAL_ADMIT_V2",
        "JOURNAL_EXPOSURE_GATE_V2",
        "JOURNAL_SETTLE_V2"
      ]
    },
    "admission": {
      "$ref": "#/$defs/V2AdmissionPlan"
    },
    "exposure_gate": {
      "oneOf": [
        {"$ref": "#/$defs/V2ExposureGatePlan"},
        {"type": "null"}
      ]
    },
    "settlement": {
      "oneOf": [
        {"$ref": "#/$defs/V2SettlementPlan"},
        {"type": "null"}
      ]
    },
    "authority": {
      "$ref": "#/$defs/V2AuthorityState"
    },
    "provider": {
      "$ref": "#/$defs/V2ProviderCapability"
    },
    "existing_binding": {
      "oneOf": [
        {"$ref": "#/$defs/V2ExistingBinding"},
        {"type": "null"}
      ]
    },
    "request_digest": {
      "$ref": "#/$defs/V2Digest"
    }
  },
  "required": [
    "contract_version",
    "operation",
    "admission",
    "exposure_gate",
    "settlement",
    "authority",
    "provider",
    "existing_binding",
    "request_digest"
  ],
  "$defs": {
    "V2ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_./:-]+$"
    },
    "V2Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "V2UTCMillis": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "V2SafeUInt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "V2Subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_id": {"$ref": "#/$defs/V2ID"},
        "identity_source_id": {"$ref": "#/$defs/V2ID"},
        "identity_source_version": {"$ref": "#/$defs/V2ID"}
      },
      "required": ["subject_id", "identity_source_id", "identity_source_version"]
    },
    "V2ScopedEpoch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["AUTHORITY", "CONTEXT", "CREDENTIAL"]},
        "scope_id": {"$ref": "#/$defs/V2ID"},
        "epoch": {"$ref": "#/$defs/V2SafeUInt"}
      },
      "required": ["kind", "scope_id", "epoch"]
    },
    "V2PreparedObject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/V2ID"},
        "digest": {"$ref": "#/$defs/V2Digest"},
        "object_ref": {"$ref": "#/$defs/V2ID"}
      },
      "required": ["id", "digest", "object_ref"]
    },
    "V2AdmissionKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": {"$ref": "#/$defs/V2ID"},
        "round": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "context_manifest_id": {"$ref": "#/$defs/V2ID"},
        "persona_id": {"enum": ["melchior", "balthasar", "casper"]},
        "delivery_id": {"$ref": "#/$defs/V2ID"},
        "provider_request_id": {"$ref": "#/$defs/V2ID"}
      },
      "required": ["case_id", "round", "context_manifest_id", "persona_id", "delivery_id", "provider_request_id"]
    },
    "V2HighWatermarkPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "journal_id": {"$ref": "#/$defs/V2ID"},
        "expected": {"$ref": "#/$defs/V2SafeUInt"},
        "next": {"$ref": "#/$defs/V2SafeUInt"}
      },
      "required": ["journal_id", "expected", "next"]
    },
    "V2ProviderReservationPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {"$ref": "#/$defs/V2ID"},
        "session_scope_id": {"$ref": "#/$defs/V2ID"},
        "expected_status": {"enum": ["ABSENT"]},
        "next_status": {"enum": ["RESERVED"]}
      },
      "required": ["request_id", "session_scope_id", "expected_status", "next_status"]
    },
    "V2PendingTransitionPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "journal_id": {"$ref": "#/$defs/V2ID"},
        "expected": {"$ref": "#/$defs/V2SafeUInt"},
        "next": {"$ref": "#/$defs/V2SafeUInt"}
      },
      "required": ["journal_id", "expected", "next"]
    },
    "V2ExposureFencePlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["AUTHORITY_ORDERED_GATE", "PROVIDER_ENFORCED_LEASE"]},
        "lease_id": {"$ref": "#/$defs/V2ID"},
        "lease_until": {"$ref": "#/$defs/V2UTCMillis"},
        "authority_watermark": {"$ref": "#/$defs/V2SafeUInt"},
        "execution_generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "scoped_epochs": {
          "type": "array",
          "items": {"$ref": "#/$defs/V2ScopedEpoch"},
          "minItems": 3,
          "maxItems": 3
        },
        "provider_capability_ref": {"$ref": "#/$defs/V2PreparedObject"}
      },
      "required": ["mode", "lease_id", "lease_until", "authority_watermark", "execution_generation", "scoped_epochs", "provider_capability_ref"]
    },
    "V2AdmissionPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {"$ref": "#/$defs/V2AdmissionKey"},
        "principal": {"$ref": "#/$defs/V2Subject"},
        "execution_generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "scoped_epochs": {
          "type": "array",
          "items": {"$ref": "#/$defs/V2ScopedEpoch"},
          "minItems": 3,
          "maxItems": 3
        },
        "mutation_set": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "uniqueItems": true
        },
        "admission_input": {"$ref": "#/$defs/V2PreparedObject"},
        "journal_event_input": {"$ref": "#/$defs/V2PreparedObject"},
        "dependency_edge_inputs": {
          "type": "array",
          "items": {"$ref": "#/$defs/V2PreparedObject"},
          "minItems": 0,
          "maxItems": 64
        },
        "high_watermark": {"$ref": "#/$defs/V2HighWatermarkPlan"},
        "provider_reservation": {"$ref": "#/$defs/V2ProviderReservationPlan"},
        "pending_transition": {"$ref": "#/$defs/V2PendingTransitionPlan"},
        "fence": {"$ref": "#/$defs/V2ExposureFencePlan"}
      },
      "required": ["key", "principal", "execution_generation", "scoped_epochs", "mutation_set", "admission_input", "journal_event_input", "dependency_edge_inputs", "high_watermark", "provider_reservation", "pending_transition", "fence"]
    },
    "V2ExposureGatePlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gate_id": {"$ref": "#/$defs/V2ID"},
        "admission_commit_id": {"$ref": "#/$defs/V2ID"},
        "fence_id": {"$ref": "#/$defs/V2ID"},
        "linearization_sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "trusted_now": {"$ref": "#/$defs/V2UTCMillis"}
      },
      "required": ["gate_id", "admission_commit_id", "fence_id", "linearization_sequence", "trusted_now"]
    },
    "V2ProviderReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt_id": {"$ref": "#/$defs/V2ID"},
        "verified": {"type": "boolean"},
        "provider_request_id": {"$ref": "#/$defs/V2ID"},
        "session_scope_id": {"$ref": "#/$defs/V2ID"},
        "applied_at": {"$ref": "#/$defs/V2UTCMillis"},
        "verification_ref": {"$ref": "#/$defs/V2PreparedObject"},
        "outcome": {"enum": ["APPLIED_VERIFIED", "UNVERIFIABLE", "UNKNOWN"]}
      },
      "required": ["receipt_id", "verified", "provider_request_id", "session_scope_id", "applied_at", "verification_ref", "outcome"]
    },
    "V2SettlementPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admission_commit_id": {"$ref": "#/$defs/V2ID"},
        "provider_request_id": {"$ref": "#/$defs/V2ID"},
        "expected_status": {"enum": ["ADMITTED"]},
        "next_status": {"enum": ["APPLIED_VERIFIED", "UNVERIFIABLE"]},
        "receipt": {"$ref": "#/$defs/V2ProviderReceipt"},
        "pending_transition": {"$ref": "#/$defs/V2PendingTransitionPlan"},
        "mutation_set": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["admission_commit_id", "provider_request_id", "expected_status", "next_status", "receipt", "pending_transition", "mutation_set"]
    },
    "V2AuthorityState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admission_commit_id": {"type": "string", "maxLength": 256},
        "admission_sequence": {"$ref": "#/$defs/V2SafeUInt"},
        "revocation_sequence": {"$ref": "#/$defs/V2SafeUInt"},
        "revocation_scope_id": {"type": "string", "maxLength": 256},
        "revocation_epoch": {"$ref": "#/$defs/V2SafeUInt"},
        "gate_sequence": {"$ref": "#/$defs/V2SafeUInt"},
        "settlement_sequence": {"$ref": "#/$defs/V2SafeUInt"},
        "current_generation": {"$ref": "#/$defs/V2SafeUInt"},
        "current_authority_epoch": {"$ref": "#/$defs/V2SafeUInt"},
        "current_context_epoch": {"$ref": "#/$defs/V2SafeUInt"},
        "current_credential_epoch": {"$ref": "#/$defs/V2SafeUInt"},
        "trusted_now": {"$ref": "#/$defs/V2UTCMillis"}
      },
      "required": ["admission_commit_id", "admission_sequence", "revocation_sequence", "revocation_scope_id", "revocation_epoch", "gate_sequence", "settlement_sequence", "current_generation", "current_authority_epoch", "current_context_epoch", "current_credential_epoch", "trusted_now"]
    },
    "V2ProviderCapability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "available": {"type": "boolean"},
        "enforces_fence": {"type": "boolean"},
        "supports_lease": {"type": "boolean"},
        "enforces_revocation_watermark": {"type": "boolean"},
        "max_lease_until": {"$ref": "#/$defs/V2UTCMillis"}
      },
      "required": ["available", "enforces_fence", "supports_lease", "enforces_revocation_watermark", "max_lease_until"]
    },
    "V2ExistingBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_digest": {"$ref": "#/$defs/V2Digest"},
        "admission_commit_id": {"$ref": "#/$defs/V2ID"},
        "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "status": {"enum": ["ADMITTED", "EXPOSURE_GATED", "SETTLED", "UNKNOWN", "REVOKED"]},
        "exposure_permitted": {"type": "boolean"}
      },
      "required": ["request_digest", "admission_commit_id", "generation", "status", "exposure_permitted"]
    }
  }
}
