{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "magi://contracts/authority-v1/trace",
  "description": "Synthetic offline declarations only; never authenticated authority inputs.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "magi-authority/1"
    },
    "request": {
      "$ref": "#/$defs/VerifyRequest"
    },
    "token": {
      "$ref": "#/$defs/VerifiedToken"
    },
    "current": {
      "$ref": "#/$defs/CurrentDeclaration"
    },
    "commit": {
      "$ref": "#/$defs/CommitRequest"
    },
    "transaction": {
      "$ref": "#/$defs/TransactionDeclaration"
    },
    "replay": {
      "$ref": "#/$defs/ReplayDeclaration"
    },
    "action": {
      "$ref": "#/$defs/ActionDeclaration"
    },
    "admission": {
      "$ref": "#/$defs/AdmissionDeclaration"
    },
    "governance": {
      "$ref": "#/$defs/GovernanceDeclaration"
    }
  },
  "required": [
    "contract_version",
    "request",
    "token",
    "current",
    "commit",
    "transaction",
    "replay",
    "action",
    "admission",
    "governance"
