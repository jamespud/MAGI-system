      "required": [
        "issuer",
        "subject",
        "resources",
        "operations",
        "delegable",
        "not_before",
        "valid_until"
      ]
    },
    "OwnerRuleDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "UNDECLARED",
            "OWNER_ALL",
            "OWNER_THRESHOLD",
            "SINGLE_DELEGATE"
          ]
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_./:-]+$"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "consents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_./:-]+$"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "threshold_preapproved": {
          "type": "boolean"
        },
        "delegates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_./:-]+$"
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "mode",
        "owners",
        "consents",
        "threshold",
        "threshold_preapproved",
        "delegates"
      ]
    },
    "GovernanceDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root_available": {
          "type": "boolean"
        },
        "root_installed_before_target": {
          "type": "boolean"
        },
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_./:-]+$"
        },
        "authenticated_subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_./:-]+$"
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_./:-]+$"
        },
        "chain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProofHopDeclaration"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "owner_rule": {
          "$ref": "#/$defs/OwnerRuleDeclaration"
        },
        "authenticated_identity_source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_./:-]+$"
        },
        "authenticated_identity_source_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_./:-]+$"
        },
        "expected_token_issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_./:-]+$"
        }
      },
      "required": [
        "root_available",
        "root_installed_before_target",
        "root_id",
        "authenticated_subject",
        "resource_id",
        "chain",
        "owner_rule",
        "authenticated_identity_source_id",
        "authenticated_identity_source_version",
        "expected_token_issuer"
      ]
    }
  }
}
