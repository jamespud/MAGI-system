          "pattern": "^[A-Za-z0-9_./:-]+$"
        },
        "identity_source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_./:-]+$"
        },
        "identity_source_version": {
