# MAGI Configuration
# Copy to conf/magi.yaml and fill in your model API key.

model:
  api_key: "sk-your-api-key-here"          # e.g. "sk-xxx" for OpenAI, Ark API key for Doubao
  base_url: "https://api.deepseek.com"     # e.g. "https://api.openai.com/v1", "https://ark.cn-beijing.volces.com/api/v3"
  model_name: "deepseek-v4-flash"          # e.g. "gpt-4o", "doubao-pro-32k", "deepseek-chat"
  # Optional ordered failover providers. A generation/build failure moves to
  # the next provider; unset fields inherit the primary model above.
  # providers:
  #   - api_key: "sk-fallback"
  #     base_url: "https://api.openai.com/v1"
  #     model_name: "gpt-4o"

# Database (usually injected via env: MAGI_DB_DSN / MAGI_DB_DRIVER).
database:
  driver: "mysql"
  dsn: ""                                # e.g. user:pass@tcp(127.0.0.1:3307)/magi?charset=utf8mb4&parseTime=True
  log_level: "warn"                      # silent|error|warn|info — warn logs errors + slow queries only
  slow_threshold_ms: 200                 # GORM slow-query threshold; queries slower than this are logged



magi:
  max_debate_rounds: 2
  max_steps: 12
  timeout_seconds: 600            # per-agent total loop budget
  call_timeout_seconds: 180       # per chat completion cap
  approval_timeout_seconds: 3600  # how long a gated tool waits for a human decision (0 = until run cancel)
  token_budget: 150000            # per-agent token budget; compaction triggers before this
  compaction_threshold: 0         # fraction of token_budget that triggers history compaction (0 = disabled, default)

  # Optional per-role model overrides: each role (melchior/balthasar/casper)
  # may override any model field; unset fields inherit from the global `model`
  # block above. Use it for genuine cognitive diversity (different models per
  # agent). Example for melchior:
  #   melchior:
  #     model:
  #       base_url: "https://api.openai.com/v1"
  #       model_name: "gpt-4o"
  #       api_key: "sk-..."
  # Example coze-mode override (model_id only):
  #   casper:
  #     model:
  #       model_id: 42
  melchior:
    persona: "You are Melchior, the scientist. You value correctness, efficiency, and empirical validity. Analyze data, benchmarks, and technical feasibility."
    dimensions:
      - { code: "correctness", description: "Is the decision technically correct?", weight: 0.4 }
      - { code: "efficiency", description: "Does it improve efficiency?", weight: 0.3 }
      - { code: "feasibility", description: "Is it technically feasible?", weight: 0.3 }
    risk_tendency: "neutral"
    role_policy:
      enforce_assessment: true
      required_assessment: "technical"
      min_technical_score: 60
      min_weighted_utility_score: 60
      debate_directive: "Audit disputed claims with quantitative and technical evidence; expose assumptions, benchmarks, and feasibility blockers."
    evidence:
      min_evidence_count: 3
      min_quantitative_count: 1
      min_reliability: 0.7
      require_own_collected: true
      required_claim_count: 2
      required_types:
        - { type: "quantitative", min_count: 1 }
      custom_rules:
        - { code: "primary_source_required" }
        - { code: "utility_dimension_coverage" }
    reflection_policy:
      require_justification: true

  balthasar:
    persona: "You are Balthasar, the protector. You value safety, stability, and reversibility. Consider failure history, risk, compliance, and maintenance cost."
    dimensions:
      - { code: "safety", description: "Is it safe?", weight: 0.4 }
      - { code: "reversibility", description: "Can we undo it?", weight: 0.3 }
      - { code: "maintainability", description: "Is it maintainable?", weight: 0.3 }
    risk_tendency: "conservative"
    role_policy:
      enforce_assessment: true
      required_assessment: "risk"
      max_residual_risk: 0.35
      min_weighted_utility_score: 60
      debate_directive: "Stress-test the worst case, reversibility, rollback path, operational failure modes, and residual risk."
    evidence:
      min_evidence_count: 1
      required_types:
        - { type: "risk", min_count: 1 }
      custom_rules:
        - { code: "worst_case_claim_required" }
        - { code: "reversibility_assessment" }
    reflection_policy:
      require_justification: true

  casper:
    persona: "You are Casper, the innovator. You value opportunity, innovation, and user experience. Consider trends, market changes, and strategic upside."
    dimensions:
      - { code: "opportunity", description: "What opportunity does this create?", weight: 0.4 }
      - { code: "innovation", description: "Is it innovative?", weight: 0.3 }
      - { code: "user_value", description: "Does it improve user experience?", weight: 0.3 }
    risk_tendency: "aggressive"
    role_policy:
      enforce_assessment: true
      required_assessment: "opportunity"
      min_opportunity_score: 60
      min_weighted_utility_score: 60
      debate_directive: "Look for the strongest opportunity, timing advantage, user signal, and opportunity cost of waiting."
    evidence:
      min_evidence_count: 1
      required_types:
        - { type: "trend", min_count: 1 }
      custom_rules:
        - { code: "opportunity_cost_claim" }
        - { code: "time_window_assessment" }
    reflection_policy:
      require_justification: true

# Web search providers are tried in order. The local web_search tool is exposed
# when at least one provider has an API key; leave the list empty to disable it.
# The legacy `tavily.api_key` setting remains supported and becomes the primary
# Tavily provider. Supported providers: tavily, brave.
search:
  providers:
    - provider: "tavily"
      api_key: ""  # Tavily search API key
      # base_url: "https://api.tavily.com/search"
    - provider: "brave"
      api_key: ""  # Brave Search API key
      # base_url: "https://api.search.brave.com/res/v1/web/search"

# Legacy single-provider configuration (converted to the primary Tavily provider):
tavily:
  api_key: ""

# Coze mode: add these under `model:` (model_id > 0 uses Coze modelbuilder when api_key is empty):
#   model_id: 0
#   price_per_m_input_usd: 2.5
#   price_per_m_output_usd: 10.0

# API-key authentication. Set enabled: true and define at least one key.
auth:
  enabled: false
  api_keys:
    - { name: "admin", key: "change-me", user_id: 1, role: "admin" }
    # Prefer key_hash (sha256 hex of the API key) over plaintext key:
    # - { name: "ops", key_hash: "<sha256-hex>", user_id: 2, role: "admin" }

# Per-user governance.
limits:
  max_concurrent_runs_per_user: 3
  # Cumulative per-user budgets across completed runs (0 = unlimited).
  # max_tokens_per_user: 5000000
  # max_cost_usd_per_user: 20.0

# Code runner: MAGI reuses the Coze Deno + Pyodide WASM sandbox (see
# backend/sandbox.py). Guardrails below are defense-in-depth on top of it.
code_runner:
  enabled: true
  timeout_seconds: 30
  max_code_chars: 4000
  # Coze's sandbox runner supports Python only (JS returns "js not supported yet").
  allowed_languages: ["Python"]
  blocked_patterns: ["os.system", "subprocess", "eval(", "exec(", "shutil.rmtree", "socket"]
  # Deno permission allow-lists passed to the sandbox. Empty = deny all.
  allow_env: []
  allow_read: []
  allow_write: []
  allow_net: []
  allow_run: []
  allow_ffi: []
  node_modules_dir: ""
  memory_limit_mb: 100

# Built-in read-only database query tool (db_query). Executes a single
# SELECT inside a read-only transaction; write statements and multi-statement
# input are rejected. Disabled by default.
db_tool:
  enabled: false
  # driver: "mysql"            # defaults to database.driver
  # dsn: ""                    # defaults to database.dsn
  # max_rows: 50
  # max_query_chars: 2000
  # timeout_seconds: 10
  # blocked_prefixes: []       # extra statement prefixes to reject

# Deterministic feedback sensor (check_output): the model can lint its own
# JSON output against a JSON Schema and field constraint rules before
# submitting; violations are fed back so it self-corrects before human review.
feedback_tool:
  enabled: true

# External MCP servers (config-driven; tools appear as mcp_<server>_<tool>).
# stdio servers are spawned as child processes; http servers use MCP Streamable HTTP.
mcp:
  servers:
    - name: "example"
      transport: "stdio"      # or "http"
      command: "/usr/local/bin/my-mcp-server"   # required for stdio
      args: ["--flag"]
      # headers: { Authorization: "Bearer ..." }   # http servers only
      # retry_attempts: 2                          # reconnect attempts on failure
      # env: { MY_TOKEN: "secret" }
      timeout_seconds: 60
    # - name: "remote"
    #   transport: "http"
    #   url: "https://mcp.example.com/mcp"
    #   timeout_seconds: 60

# Tool approval gate: tools listed here cannot execute in autonomous runs
# unless also listed under auto_approved. Default: code_runner requires approval.
# Per-user per-tool rate limits per minute (0 = unlimited).
tool_quota:
  default_per_minute: 0
  tools:
    code_runner: 0

tool_policy:
  require_approval: ["code_runner"]
  auto_approved: []

# Distributed tracing (log sink by default; swap in an OTLP exporter for production).
tracing:
  enabled: true
  service_name: "magi"
  otlp_endpoint: ""  # e.g. http://jaeger:4318 ; empty = log sink

# RAG pipeline (HybridKnowledgeAdapter). Leave milvus.address / elasticsearch.addresses
# empty to use in-memory fake indexes (standalone-safe). The containerized stack
# (docker-compose-dev.yml) injects MAGI_MILVUS_ADDRESS / MAGI_ES_ADDRESSES via env.
embedding:
  base_url: ""              # OpenAI-compatible /embeddings endpoint, e.g. https://api.siliconflow.cn/v1
  api_key: ""               # set via MAGI_EMBEDDING_API_KEY
  model_name: "BAAI/bge-m3"
  dim: 1024                 # must match the embedding model; changing requires re-indexing
milvus:
  address: ""               # e.g. localhost:19530; empty -> fake vector index
  collection: "magi_rag_300"
elasticsearch:
  addresses: []             # e.g. ["http://localhost:9200"]; empty -> fake lexical index
  index: "magi_rag_300"
# Ground-truth benchmark defaults. Per-run query params (runs, threshold) override these.
benchmark:
  runs_per_item: 1              # counterfactual repeats per item; agreement rate = stability
  regression_threshold: 0       # fail a run when accuracy drops below this (0 = disabled)

rag:
  levels: [1800, 900, 300]
  top_k: 15
  rrf_k: 60
  merge_threshold_900: 3
  merge_threshold_1800: 2
  orphan_strategy: "keep_300"
  store_async: true
  store_workers: 4

# Optional model overrides for the Commander (task normalization + report
# drafting) and the semantic Judge (LLM-as-a-Judge evaluation). Unset fields
# inherit from the global `model` block.
# commander:
#   model:
#     model_name: "deepseek-chat"
# judge:
#   model:
#     model_name: "deepseek-chat"

# HTTP rate limiting on /api/v1 (P2 D13). Keyed by authenticated user id, falling
# back to client IP in open mode. In-memory per-instance; disable in multi-replica
# deployments where DB-backed run/tool limits already provide governance.
http_rate_limit:
  enabled: false
  per_user_per_minute: 0   # 0 = disabled dimension
  per_ip_per_minute: 0     # 0 = disabled dimension

# /metrics exposure (P2 D17). When auth_required is true and auth.enabled, /metrics
# requires the admin role; open mode still serves it unauthenticated for local dev.
metrics:
  auth_required: false

# Versioned prompt registry (P2 D12). Prompts are seeded from built-in defaults on
# first boot and can be inspected/edited via the admin API:
#   GET  /api/v1/admin/prompts            list all versions
#   GET  /api/v1/admin/prompts/:key       active version
#   PUT  /api/v1/admin/prompts/:key       {content} -> bumps version, becomes active
#   POST /api/v1/admin/prompts/:key/restore  reset to built-in default
# Keys: commander.normalize, commander.report, agent.workflow_tools, agent.workflow_notools
